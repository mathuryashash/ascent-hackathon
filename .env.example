# Project Chimera — Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to git.

# ─── Tool Configuration (used by security_tools.py) ───────────────────────
LOG_PATH=/app/victim-logs/access.log
VICTIM_SRC_PATH=/app/victim-src/
VICTIM_LOG_PATH=./services/victim_sandbox/logs/access.log

# ─── Webhook URL (used by siem_simulator.py) ──────────────────────────────
WEBHOOK_URL=http://localhost:8000/webhook/alert

# ─── Orchestrator Settings ────────────────────────────────────────────────
ORCHESTRATOR_PORT=8000

# ─── Additional AI API Keys ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# Get yours at: https://aistudio.google.com/app/apikey

GROQ_API_KEY=your-groq-api-key-here
# Get yours at: https://console.groq.com/keys

ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Get yours at: https://console.anthropic.com/settings/keys

# ─── Webhook Security ──────────────────────────────────────────────────────
WEBHOOK_SECRET=
# REQUIRED. Must be at least 32 characters. Both orchestrator and SIEM will refuse
# to start if this is empty or shorter than 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"

# ─── LangGraph Checkpoint ─────────────────────────────────────────────────
CHECKPOINT_PATH=/app/checkpoints/chimera.db

# ─── Target Container ─────────────────────────────────────────────────────
VICTIM_CONTAINER=chimera-victim
