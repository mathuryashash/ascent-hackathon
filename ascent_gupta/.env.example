# ── LLM API Keys ────────────────────────────────────────────────────────────
# Groq — Investigator (Llama 3 70B, ultra-low latency red-team loops)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google AI Studio — Architect (Gemini 2.5 Pro) + Scout (Gemini 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Webhook Security ─────────────────────────────────────────────────────────
# Shared HMAC-SHA256 secret between SIEM and Orchestrator.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=replace_with_a_strong_random_hex_secret

# ── Container Names (override if running multiple stacks) ────────────────────
SANDBOX_CONTAINER=chimera-sandbox-1
VICTIM_CONTAINER=chimera-victim-1

# ── Paths ────────────────────────────────────────────────────────────────────
VICTIM_SRC_PATH=/victim_src
